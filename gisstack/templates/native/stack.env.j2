# gisstack native settings ({{ version }}). Any value can be overridden from
# the environment:  PG_VERSION=16 ./install.sh
# Contains secrets -> installed as /etc/gisstack/stack.env with mode 600.
DOMAIN="${DOMAIN:-{{ domain }}}"
TLS_MODE="${TLS_MODE:-{{ tls }}}"
ACME_EMAIL="${ACME_EMAIL:-{{ cfg.email }}}"

PG_VERSION="${PG_VERSION:-{{ pg.version }}}"
DB_NAME="${DB_NAME:-{{ pg.db }}}"
DB_USER="${DB_USER:-{{ pg.user }}}"
DB_PASSWORD="${DB_PASSWORD:-{{ pg.password }}}"
PG_REMOTE_ACCESS="${PG_REMOTE_ACCESS:-{{ 1 if pg.remote_access else 0 }}}"
PG_ALLOWED_CIDR="${PG_ALLOWED_CIDR:-{{ pg.allowed_cidr }}}"
PG_PORT="${PG_PORT:-{{ pg.port }}}"
PG_SHARED_BUFFERS="${PG_SHARED_BUFFERS:-{{ tuning.shared_buffers }}}"
PG_EFFECTIVE_CACHE_SIZE="${PG_EFFECTIVE_CACHE_SIZE:-{{ tuning.effective_cache_size }}}"
PG_WORK_MEM="${PG_WORK_MEM:-{{ tuning.work_mem }}}"
PG_MAINTENANCE_WORK_MEM="${PG_MAINTENANCE_WORK_MEM:-{{ tuning.maintenance_work_mem }}}"
PG_MAX_CONNECTIONS="${PG_MAX_CONNECTIONS:-{{ tuning.max_connections }}}"
PG_PRELOAD="${PG_PRELOAD:-{{ preload | join(',') }}}"

JAVA_VERSION="${JAVA_VERSION:-{{ gs.java }}}"
TOMCAT_MAJOR="${TOMCAT_MAJOR:-{{ tomcat.major }}}"       # 9 | 10.1 | 11
TOMCAT_VERSION="${TOMCAT_VERSION:-auto}"                  # auto = newest patch of that major
TOMCAT_PORT="${TOMCAT_PORT:-{{ tomcat.port }}}"
TOMCAT_HEAP_MB="${TOMCAT_HEAP_MB:-{{ tomcat.heap_mb if not c.geoserver else gs.heap_mb }}}"

GS_VERSION="${GS_VERSION:-{{ gs.version }}}"
GS_ADMIN_USER="${GS_ADMIN_USER:-admin}"
GS_ADMIN_PASSWORD="${GS_ADMIN_PASSWORD:-{{ gs.admin_password }}}"
GS_DATA_DIR="${GS_DATA_DIR:-/var/lib/gisstack/geoserver_data}"
GS_EXTENSIONS="${GS_EXTENSIONS:-{{ gs_extensions | join(' ') }}}"

QGIS_PROJECTS_DIR="${QGIS_PROJECTS_DIR:-{{ qgis.projects_dir }}}"
QGIS_PROCESSES="${QGIS_PROCESSES:-{{ qgis.processes }}}"
QGIS_OFFICIAL_REPO="${QGIS_OFFICIAL_REPO:-0}"             # 1 = use qgis.org packages (newer)

MAPPROXY_WORKERS="${MAPPROXY_WORKERS:-{{ mp.workers }}}"
BIND_BACKENDS="${BIND_BACKENDS:-{{ '127.0.0.1' if c.caddy else '0.0.0.0' }}}"   # backends are local-only behind Caddy

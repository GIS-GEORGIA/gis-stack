# gisstack native settings ({{ version }}). Any value can be overridden from
# the environment:  PG_VERSION=16 ./install.sh
# Contains secrets -> installed as /etc/gisstack/stack.env with mode 600.
DOMAIN="${DOMAIN:-{{ (domain) | shdw }}}"
TLS_MODE="${TLS_MODE:-{{ (tls) | shdw }}}"
ACME_EMAIL="${ACME_EMAIL:-{{ (cfg.email) | shdw }}}"

PG_VERSION="${PG_VERSION:-{{ (pg.version) | shdw }}}"
DB_NAME="${DB_NAME:-{{ (pg.db) | shdw }}}"
DB_USER="${DB_USER:-{{ (pg.user) | shdw }}}"
DB_PASSWORD="${DB_PASSWORD:-{{ (pg.password) | shdw }}}"
PG_REMOTE_ACCESS="${PG_REMOTE_ACCESS:-{{ (1 if pg.remote_access else 0) | shdw }}}"
PG_ALLOWED_CIDR="${PG_ALLOWED_CIDR:-{{ (pg.allowed_cidr) | shdw }}}"
PG_PORT="${PG_PORT:-{{ (pg.port) | shdw }}}"
PG_SHARED_BUFFERS="${PG_SHARED_BUFFERS:-{{ (tuning.shared_buffers) | shdw }}}"
PG_EFFECTIVE_CACHE_SIZE="${PG_EFFECTIVE_CACHE_SIZE:-{{ (tuning.effective_cache_size) | shdw }}}"
PG_WORK_MEM="${PG_WORK_MEM:-{{ (tuning.work_mem) | shdw }}}"
PG_MAINTENANCE_WORK_MEM="${PG_MAINTENANCE_WORK_MEM:-{{ (tuning.maintenance_work_mem) | shdw }}}"
PG_MAX_CONNECTIONS="${PG_MAX_CONNECTIONS:-{{ (tuning.max_connections) | shdw }}}"
PG_PRELOAD="${PG_PRELOAD:-{{ (preload | join(',')) | shdw }}}"

JAVA_VERSION="${JAVA_VERSION:-{{ (gs.java) | shdw }}}"
TOMCAT_MAJOR="${TOMCAT_MAJOR:-{{ (tomcat.major) | shdw }}}"       # 9 | 10.1 | 11
TOMCAT_VERSION="${TOMCAT_VERSION:-auto}"                  # auto = newest patch of that major
TOMCAT_PORT="${TOMCAT_PORT:-{{ (tomcat.port) | shdw }}}"
TOMCAT_HEAP_MB="${TOMCAT_HEAP_MB:-{{ (tomcat.heap_mb if not c.geoserver else gs.heap_mb) | shdw }}}"

GS_VERSION="${GS_VERSION:-{{ (gs.version) | shdw }}}"
GS_ALLOW_UNVERIFIED="${GS_ALLOW_UNVERIFIED:-0}"             # 1 = allow downloads that have no pinned SHA-256 (e.g. a custom GS_VERSION)
CADDY_VERSION="${CADDY_VERSION:-{{ caddy_version | shdw }}}"
GS_ADMIN_USER="${GS_ADMIN_USER:-admin}"
GS_ADMIN_PASSWORD="${GS_ADMIN_PASSWORD:-{{ (gs.admin_password) | shdw }}}"
GS_DATA_DIR="${GS_DATA_DIR:-/var/lib/gisstack/geoserver_data}"
GS_EXTENSIONS="${GS_EXTENSIONS:-{{ (gs_extensions | join(' ')) | shdw }}}"

QGIS_PROJECTS_DIR="${QGIS_PROJECTS_DIR:-{{ (qgis.projects_dir) | shdw }}}"
QGIS_PROCESSES="${QGIS_PROCESSES:-{{ (qgis.processes) | shdw }}}"
QGIS_OFFICIAL_REPO="${QGIS_OFFICIAL_REPO:-0}"             # 1 = use qgis.org packages (newer)

MAPPROXY_WORKERS="${MAPPROXY_WORKERS:-{{ (mp.workers) | shdw }}}"
BIND_BACKENDS="${BIND_BACKENDS:-{{ ('127.0.0.1' if c.caddy else '0.0.0.0') | shdw }}}"   # backends are local-only behind Caddy

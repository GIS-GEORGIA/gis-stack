# Generated by gisstack {{ version }}
# Works with:  docker compose  |  podman compose  |  podman-compose
# Start:       ./up.sh          (or:  docker compose up -d --build)
{% set Z = ',z' if runtime == 'podman' else '' %}
{% set pgdir = '/var/lib/postgresql' if (pg.version | int) >= 18 else '/var/lib/postgresql/data' %}
name: {{ project }}
{% if runtime == 'podman' %}

# podman-compose puts every service of a project into one Podman pod by default. On rootless Podman 4.x that fails ("unable to create pod cgroup ...:
# Unit user-libpod_pod_<id>.slice was already loaded"), and gis-stack does not need a pod: the services reach each other by name on the project network.
x-podman:
  in_pod: false
{% endif %}

services:
{% if c.postgis %}
  postgis:
{% if image_pkgs %}
    build:
      context: ./postgis
      args:
        PG_IMAGE: {{ reg }}postgis/postgis:{{ pg_image_tag }}
    image: {{ project }}-postgis:{{ pg.version }}
{% else %}
    image: {{ reg }}postgis/postgis:{{ pg_image_tag }}
{% endif %}
    restart: unless-stopped
{{ hard.postgis }}
    environment:
      POSTGRES_DB: ${POSTGRES_DB}
      POSTGRES_USER: ${POSTGRES_USER}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
    command:
      - postgres
      - -c
      - shared_buffers={{ tuning.shared_buffers }}
      - -c
      - effective_cache_size={{ tuning.effective_cache_size }}
      - -c
      - work_mem={{ tuning.work_mem }}
      - -c
      - maintenance_work_mem={{ tuning.maintenance_work_mem }}
      - -c
      - max_connections={{ tuning.max_connections }}
{% if preload %}
      - -c
      - shared_preload_libraries={{ preload | join(',') }}
{% endif %}
    volumes:
      - pgdata:{{ pgdir }}
      - ./postgis/init:/docker-entrypoint-initdb.d:ro{{ Z }}
    ports:
      - "{{ '' if pg.remote_access else '127.0.0.1:' }}{{ pg.port }}:5432"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U $${POSTGRES_USER} -d $${POSTGRES_DB}"]
      interval: 10s
      timeout: 5s
      retries: 12
{% endif %}
{% if c.geoserver %}

  geoserver:
    image: {{ gs.image | yq }}
    restart: unless-stopped
{{ hard.geoserver }}
{% if c.postgis %}
    depends_on:
      postgis:
        condition: service_healthy
{% endif %}
    environment:
      GEOSERVER_ADMIN_USER: admin
      GEOSERVER_ADMIN_PASSWORD: ${GS_ADMIN_PASSWORD}
      EXTRA_JAVA_OPTS: "-Xms512m -Xmx{{ gs.heap_mb }}m"
      CSRF_WHITELIST: {{ domain }}
      PROXY_BASE_URL: {{ public }}/geoserver
      SKIP_DEMO_DATA: "true"
{% if gs_extensions %}
      INSTALL_EXTENSIONS: "true"
      STABLE_EXTENSIONS: "{{ gs_extensions | join(',') }}"
{% endif %}
    volumes:
      - geoserver_data:/opt/geoserver_data
{% if not c.caddy %}
    ports:
      - "{{ bind }}:8080:8080"
{% endif %}
{% endif %}
{% if c.tomcat %}

  tomcat:
    image: {{ reg }}tomcat:{{ '11.0' if tomcat.major == '11' else ('10.1' if tomcat.major == '10.1' else '9.0') }}-jre{{ gs.java }}
    restart: unless-stopped
{{ hard.tomcat }}
    environment:
      CATALINA_OPTS: "-Xms256m -Xmx{{ tomcat.heap_mb }}m -Djava.awt.headless=true"
    volumes:
      - ./tomcat/webapps:/usr/local/tomcat/webapps{{ Z and (':' ~ Z[1:]) }}
{% if not c.caddy %}
    ports:
      - "{{ bind }}:8081:8080"
{% endif %}
{% endif %}
{% if c.qgis_server %}

  qgis:
    image: {{ reg }}camptocamp/qgis-server:latest   # change the tag to pin a QGIS release
    restart: unless-stopped
{{ hard.qgis }}
    environment:
      QGIS_SERVER_LOG_LEVEL: "1"
      QGIS_SERVER_PARALLEL_RENDERING: "true"
    volumes:
      - ./qgis/projects:/etc/qgisserver:ro{{ Z }}
{% if not c.caddy %}
    ports:
      - "{{ bind }}:8380:80"
{% endif %}
{% endif %}
{% if c.mapproxy %}

  mapproxy:
    build: ./mapproxy
    image: {{ project }}-mapproxy:latest
    restart: unless-stopped
{{ hard.mapproxy }}
    command: ["gunicorn", "--chdir", "/etc/mapproxy", "--workers", "{{ mp.workers }}", "--timeout", "120", "--bind", "0.0.0.0:8081", "app:application"]
    volumes:
      - ./mapproxy:/etc/mapproxy:ro{{ Z }}
      - mapproxy_cache:/var/lib/mapproxy
{% if not c.caddy %}
    ports:
      - "{{ bind }}:8081:8081"
{% endif %}
{% endif %}
{% if c.caddy %}

  caddy:
    image: {{ reg }}caddy:2
    restart: unless-stopped
{{ hard.caddy }}
    ports:
      - "${HTTP_PORT:-80}:80"
      - "${HTTPS_PORT:-443}:443"
      - "${HTTPS_PORT:-443}:443/udp"
    volumes:
      - ./caddy/Caddyfile:/etc/caddy/Caddyfile:ro{{ Z }}
{% if c.webmap %}
      - ./webmap:/srv/webmap:ro{{ Z }}
{% endif %}
      - caddy_data:/data
      - caddy_config:/config
{% endif %}

{% if c.postgis or c.geoserver or c.mapproxy or c.caddy %}
volumes:
{% if c.postgis %}
  pgdata:
{% endif %}
{% if c.geoserver %}
  geoserver_data:
{% endif %}
{% if c.mapproxy %}
  mapproxy_cache:
{% endif %}
{% if c.caddy %}
  caddy_data:
  caddy_config:
{% endif %}
{% endif %}

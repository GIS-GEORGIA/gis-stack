POSTGRES_DB={{ pg.db }}
POSTGRES_USER={{ pg.user }}
POSTGRES_PASSWORD={{ pg.password }}
GS_ADMIN_PASSWORD={{ gs.admin_password }}
# Rootless Podman cannot bind ports below 1024 unless you run:
#   sudo sysctl -w net.ipv4.ip_unprivileged_port_start=80
# or use e.g. HTTP_PORT=8080 HTTPS_PORT=8443 here.  Limitation (verified with real Caddy): the stack then answers on those ports, but Caddy's
# http->https redirect and the URLs GeoServer / the web map advertise still name the standard port; reach the stack by its https URL with the port.
HTTP_PORT=80
HTTPS_PORT=443

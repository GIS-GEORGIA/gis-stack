# Rootless Podman cannot bind ports below 1024 unless you run:
#   sudo sysctl -w net.ipv4.ip_unprivileged_port_start=80
# or set e.g. HTTP_PORT=8080 HTTPS_PORT=8443 here.  Caddy's http->https redirect and the URLs
# GeoServer advertises then name the port (with the standard ports they carry an explicit :80 / :443, which is equivalent).
HTTP_PORT=80
HTTPS_PORT=443

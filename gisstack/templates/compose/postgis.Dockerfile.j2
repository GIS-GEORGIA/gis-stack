# Generated by gisstack {{ version }}
# Adds the selected extensions to the official PostGIS image (Debian based).
ARG PG_IMAGE=postgis/postgis:{{ pg_image_tag }}
FROM ${PG_IMAGE}
{% if image_pkgs %}
RUN apt-get update \
 && apt-get install -y --no-install-recommends {{ image_pkgs | join(' ') }} \
 && rm -rf /var/lib/apt/lists/*
{% endif %}

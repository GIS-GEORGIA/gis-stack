// Written against the v10 API (`mapStyle` prop). The library's API changes between
// major versions - check its README if the import below fails.
// Then in App.js:  import MapLibreScreen from './src/MapLibreScreen';  and render <MapLibreScreen />.
import React, { useMemo, useState } from 'react';
import { Pressable, StyleSheet, Switch, Text, View } from 'react-native';
import MapLibreGL from '@maplibre/maplibre-react-native';
import { CONFIG, SERVER } from './config';
import { STRINGS } from './i18n';

const abs = (u) => (u.startsWith('http') ? u : SERVER + u).replace('{s}', 'a').replace('{r}', '');

function buildStyle(enabled) {
  const sources = {};
  const layers = [{ id: 'bg', type: 'background', paint: { 'background-color': '#dfe7ee' } }];
  if (CONFIG.basemap) {
    sources.base = { type: 'raster', tileSize: 256, tiles: [abs(CONFIG.basemap.url)], maxzoom: 19 };
    layers.push({ id: 'base', type: 'raster', source: 'base' });
  }
  CONFIG.layers.forEach((l) => {
    if (!enabled[l.id]) return;
    const tiles = l.type === 'wms'
      ? [`${SERVER}${l.url}?service=WMS&version=1.1.1&request=GetMap&layers=${encodeURIComponent(l.layers)}` +
         `&styles=&format=image/png&transparent=true&srs=EPSG:3857&width=256&height=256&bbox={bbox-epsg-3857}`]
      : [abs(l.url)];
    sources[l.id] = { type: 'raster', tileSize: 256, tiles };
    layers.push({ id: l.id, type: 'raster', source: l.id });
  });
  return { version: 8, sources, layers };
}

export default function MapLibreScreen() {
  const [lang, setLang] = useState(CONFIG.lang || 'ka');
  const [enabled, setEnabled] = useState(() => Object.fromEntries(CONFIG.layers.map((l, i) => [l.id, i === 0])));
  const style = useMemo(() => JSON.stringify(buildStyle(enabled)), [enabled]);
  const t = STRINGS[lang];
  return (
    <View style={styles.fill}>
      <MapLibreGL.MapView style={styles.fill} mapStyle={style}>
        <MapLibreGL.Camera zoomLevel={CONFIG.zoom - 1} centerCoordinate={[CONFIG.center[1], CONFIG.center[0]]} />
      </MapLibreGL.MapView>
      <View style={styles.panel}>
        <Pressable onPress={() => setLang(lang === 'ka' ? 'en' : 'ka')}><Text style={styles.lang}>{lang === 'ka' ? 'EN' : 'ქართ'}</Text></Pressable>
        <Text style={styles.h}>{t.layers}</Text>
        {CONFIG.layers.map((l) => (
          <View key={l.id} style={styles.row}>
            <Text style={styles.grow}>{l.title[lang] || l.title.en}</Text>
            <Switch value={!!enabled[l.id]} onValueChange={(v) => setEnabled({ ...enabled, [l.id]: v })} />
          </View>
        ))}
      </View>
    </View>
  );
}

const styles = StyleSheet.create({
  fill: { flex: 1 },
  grow: { flex: 1 },
  panel: { position: 'absolute', top: 48, right: 10, width: 220, backgroundColor: 'rgba(255,255,255,.95)', padding: 10, borderRadius: 8 },
  h: { fontWeight: '600', marginVertical: 6 },
  row: { flexDirection: 'row', alignItems: 'center' },
  lang: { alignSelf: 'flex-end', fontWeight: '700' },
});

import React, { useRef, useState } from 'react';
import { ActivityIndicator, Pressable, StyleSheet, Text, View } from 'react-native';
import { SafeAreaView } from 'react-native-safe-area-context';
import { StatusBar } from 'expo-status-bar';
import { WebView } from 'react-native-webview';
import { CONFIG, SERVER } from './src/config';
import { STRINGS } from './src/i18n';

export default function App() {
  const [lang, setLang] = useState(CONFIG.lang || 'ka');
  const [failed, setFailed] = useState(false);
  const web = useRef(null);
  const t = STRINGS[lang];
  const webSource = { uri: `${SERVER}/?lang=${lang}` };

  return (
    <SafeAreaView style={styles.root}>
      <StatusBar style="light" />
      <View style={styles.bar}>
        <Text style={styles.title} numberOfLines={1}>{CONFIG.title[lang]}</Text>
        <View style={styles.langs}>
          {['ka', 'en'].map((l) => (
            <Pressable key={l} onPress={() => setLang(l)} style={[styles.lang, l === lang && styles.langOn]}>
              <Text style={[styles.langText, l === lang && styles.langTextOn]}>{l === 'ka' ? 'ქართ' : 'EN'}</Text>
            </Pressable>
          ))}
        </View>
      </View>
      {failed ? (
        <View style={styles.center}>
          <Text style={styles.err}>{t.offline}</Text>
          <Pressable style={styles.btn} onPress={() => { setFailed(false); web.current?.reload(); }}>
            <Text style={styles.btnText}>{t.retry}</Text>
          </Pressable>
        </View>
      ) : (
        <WebView
          ref={web}
          key={lang}
          source={webSource}
          style={styles.web}
          startInLoadingState
          renderLoading={() => <ActivityIndicator style={styles.center} size="large" />}
          onError={() => setFailed(true)}
          onHttpError={() => setFailed(true)}
          geolocationEnabled
          setSupportMultipleWindows={false}
        />
      )}
    </SafeAreaView>
  );
}

const styles = StyleSheet.create({
  root: { flex: 1, backgroundColor: '#14385c' },
  bar: { flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', padding: 10 },
  title: { color: '#fff', fontSize: 16, fontWeight: '600', flex: 1, marginRight: 8 },
  langs: { flexDirection: 'row' },
  lang: { borderWidth: 1, borderColor: 'rgba(255,255,255,.5)', paddingVertical: 4, paddingHorizontal: 10 },
  langOn: { backgroundColor: '#f2b134', borderColor: '#f2b134' },
  langText: { color: '#fff' },
  langTextOn: { color: '#1b1b1b' },
  web: { flex: 1 },
  center: { flex: 1, alignItems: 'center', justifyContent: 'center', backgroundColor: '#fff' },
  err: { fontSize: 16, marginBottom: 12 },
  btn: { backgroundColor: '#14385c', paddingVertical: 10, paddingHorizontal: 20, borderRadius: 6 },
  btnText: { color: '#fff' },
});

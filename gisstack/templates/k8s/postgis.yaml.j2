# Generated by gisstack {{ version }}
{% set pgdir = '/var/lib/postgresql' if (pg.version | int) >= 18 else '/var/lib/postgresql/data' %}
apiVersion: v1
kind: Service
metadata:
  name: postgis
spec:
  selector:
    app: postgis
  ports:
    - name: pg
      port: 5432
      targetPort: 5432
---
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: postgis
spec:
  serviceName: postgis
  replicas: 1
  selector:
    matchLabels:
      app: postgis
  template:
    metadata:
      labels:
        app: postgis
    spec:
      containers:
        - name: postgis
          image: {{ k8s.postgis_image or ('postgis/postgis:' ~ pg_image_tag) }}
          args:
            - postgres
            - -c
            - shared_buffers={{ tuning.shared_buffers }}
            - -c
            - effective_cache_size={{ tuning.effective_cache_size }}
            - -c
            - work_mem={{ tuning.work_mem }}
            - -c
            - maintenance_work_mem={{ tuning.maintenance_work_mem }}
            - -c
            - max_connections={{ tuning.max_connections }}
{% if preload %}
            - -c
            - shared_preload_libraries={{ preload | join(',') }}
{% endif %}
          envFrom:
            - secretRef:
                name: gisstack-secrets
{% if (pg.version | int) < 18 %}
          env:
            - name: PGDATA
              value: /var/lib/postgresql/data/pgdata
{% endif %}
          ports:
            - containerPort: 5432
          readinessProbe:
            exec:
              command: ["sh", "-c", "pg_isready -U \"$POSTGRES_USER\" -d \"$POSTGRES_DB\""]
            initialDelaySeconds: 10
            periodSeconds: 10
          resources:
            requests:
              memory: {{ [pg.ram_gb | int * 256, 512] | max }}Mi
          volumeMounts:
            - name: data
              mountPath: {{ pgdir }}
            - name: init
              mountPath: /docker-entrypoint-initdb.d
      volumes:
        - name: init
          configMap:
            name: postgis-init
  volumeClaimTemplates:
    - metadata:
        name: data
      spec:
        accessModes: ["ReadWriteOnce"]
{% if k8s.storage_class %}
        storageClassName: {{ k8s.storage_class }}
{% endif %}
        resources:
          requests:
            storage: {{ k8s.pg_storage }}

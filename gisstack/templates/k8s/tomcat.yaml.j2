# Generated by gisstack {{ version }} -- generic Tomcat for your own WAR files
apiVersion: v1
kind: Service
metadata:
  name: tomcat
spec:
  selector:
    app: tomcat
  ports:
    - name: http
      port: 8080
      targetPort: 8080
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: tomcat
spec:
  replicas: 1
  selector:
    matchLabels:
      app: tomcat
  template:
    metadata:
      labels:
        app: tomcat
    spec:
      containers:
        - name: tomcat
          image: tomcat:{{ '11.0' if tomcat.major == '11' else ('10.1' if tomcat.major == '10.1' else '9.0') }}-jre{{ gs.java }}
          env:
            - name: CATALINA_OPTS
              value: "-Xms256m -Xmx{{ tomcat.heap_mb }}m -Djava.awt.headless=true"
          ports:
            - containerPort: 8080
          readinessProbe:
            tcpSocket: {port: 8080}
            initialDelaySeconds: 10
          volumeMounts:
            - name: webapps
              mountPath: /usr/local/tomcat/webapps
      volumes:
        - name: webapps
          emptyDir: {}

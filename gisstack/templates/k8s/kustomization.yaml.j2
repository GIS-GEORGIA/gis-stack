  - secret.yaml
{% if c.postgis %}
  - postgis.yaml
{% endif %}
{% if c.geoserver %}
  - geoserver.yaml
{% endif %}
{% if c.tomcat %}
  - tomcat.yaml
{% endif %}
{% if c.mapproxy %}
  - mapproxy.yaml
{% endif %}
{% if c.qgis_server %}
  - qgis.yaml
{% endif %}
{% if c.caddy %}
  - caddy.yaml
{% endif %}
configMapGenerator:
{% if c.postgis %}

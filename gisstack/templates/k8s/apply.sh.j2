#!/usr/bin/env bash
# gisstack Kubernetes deploy {{ version }}   usage: ./apply.sh [apply|delete|status|only|clean]
set -Eeuo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")"
NS={{ k8s.namespace | shq }}
command -v kubectl >/dev/null || { echo "kubectl not found" >&2; exit 1; }

# Kubernetes does not replace a StatefulSet pod that never became ready when the template is corrected afterwards (the documented
# "forced rollback" problem): a failed upgrade would block its own fix and its rollback.  Delete only such a pod - NOT ready and on an
# outdated revision.  Its volume is kept and the pod is recreated from the current template.  Healthy pods are never touched.
replace_stale_pod() {   # $1 = statefulset name
  local rev pod hash ready n=0 waiting
  while [ "$n" -lt 6 ]; do
    waiting=0
    rev="$(kubectl -n "$NS" get statefulset "$1" -o jsonpath='{.status.updateRevision}' 2>/dev/null || true)"
    for pod in $(kubectl -n "$NS" get pods -l "app=$1" -o name 2>/dev/null); do
      ready="$(kubectl -n "$NS" get "$pod" -o jsonpath='{.status.conditions[?(@.type=="Ready")].status}' 2>/dev/null || true)"
      [ "$ready" = True ] && continue
      hash="$(kubectl -n "$NS" get "$pod" -o jsonpath='{.metadata.labels.controller-revision-hash}' 2>/dev/null || true)"
      if [ -n "$rev" ] && [ -n "$hash" ] && [ "$hash" != "$rev" ]; then
        echo "replacing ${pod#pod/}: it never became ready on the previous revision (its volume is kept)"
        kubectl -n "$NS" delete "$pod" --wait=false
      else
        waiting=1                      # not ready on the current revision (or the controller has not caught up yet): look again shortly
      fi
    done
    [ "$waiting" = 1 ] || return 0
    n=$((n + 1)); sleep 5
  done
}

case "${1:-apply}" in
  apply)
    kubectl apply -k .
{% if c.postgis %}
    replace_stale_pod postgis
    kubectl -n "$NS" rollout status statefulset/postgis --timeout=300s
{% endif %}
{% if c.geoserver %}
    kubectl -n "$NS" rollout status deployment/geoserver --timeout=600s
{% endif %}
{% if c.mapproxy %}
    kubectl -n "$NS" rollout status deployment/mapproxy --timeout=300s
{% endif %}
{% if c.caddy %}
    kubectl -n "$NS" rollout status deployment/caddy --timeout=300s
    echo
    echo "Entry point (Service type {{ k8s.service_type | shdq }}):"
    kubectl -n "$NS" get svc caddy
    echo "Point DNS for {{ domain | shdq }} at the EXTERNAL-IP above."
{% endif %}
    ;;
  delete) kubectl delete -k . ;;
  only)
    # ./apply.sh only <component> ...   apply the manifests, then wait for just these components
    shift
    [ "$#" -gt 0 ] || { echo "usage: $0 only <component>..."; exit 2; }
    kubectl apply -k .
    for c in "$@"; do
      case "$c" in qgis_server) c=qgis ;; webmap) c=caddy ;; esac
      if [ "$c" = postgis ]; then replace_stale_pod postgis; kubectl -n "$NS" rollout status statefulset/postgis --timeout=300s
      else kubectl -n "$NS" rollout status "deployment/$c" --timeout=600s; fi
    done
    ;;
  clean)
    # ./apply.sh clean [--purge] [component ...]
    #   no component: delete everything incl. the namespace (and with it ALL volumes)
    #   components : delete just their workloads; --purge also deletes their volumes
    shift
    PURGE=0; WANT=""
    for a in "$@"; do case "$a" in --purge) PURGE=1 ;; *) WANT="$WANT $a" ;; esac; done
    if [ -z "$WANT" ]; then
      kubectl delete -k . --ignore-not-found
    else
      for c in $WANT; do
        [ "$c" = qgis_server ] && c=qgis
        case "$c" in
          webmap) echo "webmap is part of the caddy deployment: clean caddy instead"; continue ;;
          postgis) kubectl -n "$NS" delete statefulset/postgis service/postgis --ignore-not-found; pvc=data-postgis-0 ;;
          geoserver) pvc=geoserver-data ;;
          mapproxy)  pvc=mapproxy-cache ;;
          caddy)     pvc=caddy-data ;;
          qgis)      pvc=qgis-projects ;;
          tomcat)    pvc="" ;;
          *) echo "unknown component: $c"; continue ;;
        esac
        if [ "$c" != postgis ]; then kubectl -n "$NS" delete "deployment/$c" "service/$c" --ignore-not-found; fi
        if [ "$PURGE" = 1 ] && [ -n "$pvc" ]; then kubectl -n "$NS" delete "pvc/$pvc" --ignore-not-found; fi
      done
    fi
    ;;
  status) kubectl -n "$NS" get pods,svc,pvc ;;
  *) echo "usage: $0 [apply|delete|status|only <component>...|clean [--purge] [component...]]"; exit 2 ;;
esac

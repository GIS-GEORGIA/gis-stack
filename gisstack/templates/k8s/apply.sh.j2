#!/usr/bin/env bash
# gisstack Kubernetes deploy {{ version }}   usage: ./apply.sh [apply|delete|status|only|clean]
set -Eeuo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")"
NS={{ k8s.namespace }}
command -v kubectl >/dev/null || { echo "kubectl not found" >&2; exit 1; }

case "${1:-apply}" in
  apply)
    kubectl apply -k .
{% if c.postgis %}
    kubectl -n "$NS" rollout status statefulset/postgis --timeout=300s
{% endif %}
{% if c.geoserver %}
    kubectl -n "$NS" rollout status deployment/geoserver --timeout=600s
{% endif %}
{% if c.mapproxy %}
    kubectl -n "$NS" rollout status deployment/mapproxy --timeout=300s
{% endif %}
{% if c.caddy %}
    kubectl -n "$NS" rollout status deployment/caddy --timeout=300s
    echo
    echo "Entry point (Service type {{ k8s.service_type }}):"
    kubectl -n "$NS" get svc caddy
    echo "Point DNS for {{ domain }} at the EXTERNAL-IP above."
{% endif %}
    ;;
  delete) kubectl delete -k . ;;
  only)
    # ./apply.sh only <component> ...   apply the manifests, then wait for just these components
    shift
    [ "$#" -gt 0 ] || { echo "usage: $0 only <component>..."; exit 2; }
    kubectl apply -k .
    for c in "$@"; do
      case "$c" in qgis_server) c=qgis ;; webmap) c=caddy ;; esac
      if [ "$c" = postgis ]; then kubectl -n "$NS" rollout status statefulset/postgis --timeout=300s
      else kubectl -n "$NS" rollout status "deployment/$c" --timeout=600s; fi
    done
    ;;
  clean)
    # ./apply.sh clean [--purge] [component ...]
    #   no component: delete everything incl. the namespace (and with it ALL volumes)
    #   components : delete just their workloads; --purge also deletes their volumes
    shift
    PURGE=0; WANT=""
    for a in "$@"; do case "$a" in --purge) PURGE=1 ;; *) WANT="$WANT $a" ;; esac; done
    if [ -z "$WANT" ]; then
      kubectl delete -k . --ignore-not-found
    else
      for c in $WANT; do
        [ "$c" = qgis_server ] && c=qgis
        case "$c" in
          webmap) echo "webmap is part of the caddy deployment: clean caddy instead"; continue ;;
          postgis) kubectl -n "$NS" delete statefulset/postgis service/postgis --ignore-not-found; pvc=data-postgis-0 ;;
          geoserver) pvc=geoserver-data ;;
          mapproxy)  pvc=mapproxy-cache ;;
          caddy)     pvc=caddy-data ;;
          qgis)      pvc=qgis-projects ;;
          tomcat)    pvc="" ;;
          *) echo "unknown component: $c"; continue ;;
        esac
        if [ "$c" != postgis ]; then kubectl -n "$NS" delete "deployment/$c" "service/$c" --ignore-not-found; fi
        if [ "$PURGE" = 1 ] && [ -n "$pvc" ]; then kubectl -n "$NS" delete "pvc/$pvc" --ignore-not-found; fi
      done
    fi
    ;;
  status) kubectl -n "$NS" get pods,svc,pvc ;;
  *) echo "usage: $0 [apply|delete|status|only <component>...|clean [--purge] [component...]]"; exit 2 ;;
esac

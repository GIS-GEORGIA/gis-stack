# Generated by gisstack {{ version }}
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: geoserver-data
spec:
  accessModes: ["ReadWriteOnce"]
{% if k8s.storage_class %}
  storageClassName: {{ k8s.storage_class }}
{% endif %}
  resources:
    requests:
      storage: {{ k8s.gs_storage }}
---
apiVersion: v1
kind: Service
metadata:
  name: geoserver
spec:
  selector:
    app: geoserver
  ports:
    - name: http
      port: 8080
      targetPort: 8080
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: geoserver
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: geoserver
  template:
    metadata:
      labels:
        app: geoserver
    spec:
      containers:
        - name: geoserver
          image: {{ gs.image }}
          env:
            - name: GEOSERVER_ADMIN_USER
              valueFrom: {secretKeyRef: {name: gisstack-secrets, key: GEOSERVER_ADMIN_USER}}
            - name: GEOSERVER_ADMIN_PASSWORD
              valueFrom: {secretKeyRef: {name: gisstack-secrets, key: GEOSERVER_ADMIN_PASSWORD}}
            - name: EXTRA_JAVA_OPTS
              value: "-Xms512m -Xmx{{ gs.heap_mb }}m"
            - name: CSRF_WHITELIST
              value: {{ domain | yq }}
            - name: PROXY_BASE_URL
              value: {{ (public ~ '/geoserver') | yq }}
            - name: SKIP_DEMO_DATA
              value: "true"
{% if gs_extensions %}
            - name: INSTALL_EXTENSIONS
              value: "true"
            - name: STABLE_EXTENSIONS
              value: {{ gs_extensions | join(',') | yq }}
{% endif %}
          ports:
            - containerPort: 8080
          readinessProbe:
            httpGet: {path: "/geoserver/ows?service=wms&request=GetCapabilities", port: 8080}
            initialDelaySeconds: 60
            periodSeconds: 10
            failureThreshold: 30
          resources:
            requests:
              memory: {{ gs.heap_mb }}Mi
          volumeMounts:
            - name: data
              mountPath: /opt/geoserver_data
      volumes:
        - name: data
          persistentVolumeClaim:
            claimName: geoserver-data

# Generated by gisstack {{ version }} -- Caddy is the single entry point (no separate Ingress needed)
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: caddy-data
spec:
  accessModes: ["ReadWriteOnce"]
{% if k8s.storage_class %}
  storageClassName: {{ k8s.storage_class | yq }}
{% endif %}
  resources:
    requests:
      storage: 1Gi
---
apiVersion: v1
kind: Service
metadata:
  name: caddy
spec:
  type: {{ k8s.service_type | yq }}
  selector:
    app: caddy
  ports:
    - name: http
      port: 80
      targetPort: 80
    - name: https
      port: 443
      targetPort: 443
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: caddy
spec:
  replicas: 1          # one replica: ACME certificates are stored on the PVC
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: caddy
  template:
    metadata:
      labels:
        app: caddy
    spec:
{{ khard_pod }}
{% if c.webmap %}
      initContainers:
        - name: unpack-webmap
{{ khard.init }}
          image: busybox:1.36
          command: ["sh", "-c", "tar xzf /src/webmap.tgz -C /srv/webmap"]
          volumeMounts:
            - name: webmap-src
              mountPath: /src
            - name: webmap
              mountPath: /srv/webmap
{% endif %}
      containers:
        - name: caddy
{{ khard.caddy }}
          image: caddy:2
          ports:
            - containerPort: 80
            - containerPort: 443
          volumeMounts:
            - name: caddyfile
              mountPath: /etc/caddy
{% if c.webmap %}
            - name: webmap
              mountPath: /srv/webmap
              readOnly: true
{% endif %}
            - name: data
              mountPath: /data
      volumes:
        - name: caddyfile
          configMap:
            name: caddyfile
{% if c.webmap %}
        - name: webmap-src
          configMap:
            name: webmap
        - name: webmap
          emptyDir: {}
{% endif %}
        - name: data
          persistentVolumeClaim:
            claimName: caddy-data

# Generated by gisstack {{ version }}
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: mapproxy-cache
spec:
  accessModes: ["ReadWriteOnce"]
{% if k8s.storage_class %}
  storageClassName: {{ k8s.storage_class | yq }}
{% endif %}
  resources:
    requests:
      storage: {{ k8s.mp_storage | yq }}
---
apiVersion: v1
kind: Service
metadata:
  name: mapproxy
spec:
  selector:
    app: mapproxy
  ports:
    - name: http
      port: 8081
      targetPort: 8081
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: mapproxy
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: mapproxy
  template:
    metadata:
      labels:
        app: mapproxy
    spec:
      containers:
        - name: mapproxy
{% if k8s.mapproxy_image %}
          image: {{ k8s.mapproxy_image | yq }}
          command: ["gunicorn", "--chdir", "/etc/mapproxy", "--workers", "{{ mp.workers }}", "--timeout", "120", "--bind", "0.0.0.0:8081", "app:application"]
{% else %}
          # No custom image configured: installs MapProxy at start-up (needs internet
          # egress, adds ~30 s). Set k8s.mapproxy_image to a pre-built image to avoid it.
          image: python:3.12-slim
          command:
            - sh
            - -c
            - >-
              pip install --no-cache-dir mapproxy gunicorn pyproj shapely &&
              mkdir -p /var/lib/mapproxy/cache_data &&
              exec gunicorn --chdir /etc/mapproxy --workers {{ mp.workers }} --timeout 120
              --bind 0.0.0.0:8081 app:application
{% endif %}
          ports:
            - containerPort: 8081
          readinessProbe:
            httpGet: {path: /demo/, port: 8081}
            initialDelaySeconds: 40
            periodSeconds: 10
            failureThreshold: 20
          volumeMounts:
            - name: config
              mountPath: /etc/mapproxy
            - name: cache
              mountPath: /var/lib/mapproxy
      volumes:
        - name: config
          configMap:
            name: mapproxy-config
        - name: cache
          persistentVolumeClaim:
            claimName: mapproxy-cache

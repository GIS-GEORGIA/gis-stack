# Generated by gisstack {{ version }}
# Copy your .qgs/.qgz projects into the PVC, e.g.:
#   kubectl -n {{ k8s.namespace }} cp myproject.qgs $(kubectl -n {{ k8s.namespace }} get pod -l app=qgis -o name | head -1 | cut -d/ -f2):/etc/qgisserver/
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: qgis-projects
spec:
  accessModes: ["ReadWriteOnce"]
{% if k8s.storage_class %}
  storageClassName: {{ k8s.storage_class | yq }}
{% endif %}
  resources:
    requests:
      storage: 2Gi
---
apiVersion: v1
kind: Service
metadata:
  name: qgis
spec:
  selector:
    app: qgis
  ports:
    - name: http
      port: 80
      targetPort: 80
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: qgis
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: qgis
  template:
    metadata:
      labels:
        app: qgis
    spec:
      containers:
        - name: qgis
          image: camptocamp/qgis-server:latest   # pin a release tag for production
          env:
            - name: QGIS_SERVER_LOG_LEVEL
              value: "1"
            - name: QGIS_SERVER_PARALLEL_RENDERING
              value: "true"
          ports:
            - containerPort: 80
          volumeMounts:
            - name: projects
              mountPath: /etc/qgisserver
      volumes:
        - name: projects
          persistentVolumeClaim:
            claimName: qgis-projects

# Generated by gisstack {{ version }} ({{ target }})
{# Compose publishes Caddy on HTTP_PORT/HTTPS_PORT from .env (container ports stay 80/443).  Caddy's own http->https redirect never names a non-standard
   port (verified with caddy 2.11), so for TLS it is replaced by the explicit redirect below, which gets the published HTTPS port from the environment. #}
{% set redirect_here = target == 'compose' and tls != 'none' %}
{% if redirect_here or tls == 'none' or (tls == 'auto' and cfg.email) %}
{
{% if tls == 'none' %}
	auto_https off
{% else %}
{% if redirect_here %}
	auto_https disable_redirects
{% endif %}
{% if tls == 'auto' and cfg.email %}
	email {{ cfg.email }}
{% endif %}
{% endif %}
}
{% endif %}
{% if redirect_here %}

http://{{ domain }} {
	redir https://{{ domain }}:{$HTTPS_PORT:443}{uri} permanent
}
{% endif %}

{% if tls == 'none' %}http://{{ domain }}{% else %}{{ domain }}{% endif %} {
{% if tls == 'internal' %}
	tls internal
{% endif %}
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

{% if c.geoserver %}
	# GeoServer (WMS/WFS/WMTS, admin UI at /geoserver/web)
	handle /geoserver* {
		reverse_proxy {{ up.geoserver }}
	}
{% endif %}
{% if c.mapproxy %}

	# MapProxy (WMS/WMTS/TMS, demo at /mapproxy/demo/)
	handle_path /mapproxy/* {
		reverse_proxy {{ up.mapproxy }} {
			header_up X-Script-Name /mapproxy
		}
	}
{% endif %}
{% if c.qgis_server %}

	# QGIS Server: /qgis/?MAP=<project>&SERVICE=WMS&REQUEST=GetCapabilities
	handle_path /qgis/* {
{% if target == 'native' %}
		reverse_proxy {{ up.qgis }} {
			transport fastcgi
		}
{% else %}
		reverse_proxy {{ up.qgis }}
{% endif %}
	}
{% endif %}
{% if c.tomcat %}

	# Other Tomcat web applications: /apps/<context>/ (manager is never exposed)
	# Tomcat drops ";parameters" from every path segment, so "/apps/x/..;/manager/html" reaches the manager although Caddy sees no "manager" prefix
	# (confirmed against real Caddy 2 + Tomcat 11: 401 from the manager instead of 403).  A segment that is empty, "." or ".." followed by ";" is
	# only ever an attempt at that, so it is refused here.  Ordinary ";jsessionid=..." suffixes on a real name stay allowed.
	@tomcat_path_trick {
		path /apps/*
		path_regexp (^|/)\.{0,2};
	}
	handle @tomcat_path_trick {
		respond "Forbidden" 403
	}
	handle /apps/manager* {
		respond "Forbidden" 403
	}
	handle /apps/host-manager* {
		respond "Forbidden" 403
	}
	handle_path /apps/* {
		reverse_proxy {{ up.tomcat }}
	}
{% endif %}

{% if c.webmap %}
	handle {
		root * {{ up.webroot }}
		try_files {path} /index.html
		file_server
	}
{% else %}
	handle {
		respond "gisstack is running" 200
	}
{% endif %}
}
{% if target == 'native' %}

# site blocks carried over from a previously installed Caddy (see: gisstack scan / reuse)
import /etc/gisstack/caddy.d/*
{% endif %}

# Generated by gisstack {{ version }}
# Run:  mapproxy-seed -f mapproxy.yaml -c 2 seed.yaml
{% if mp.seed.enabled %}
seeds:
{% for l in mp.layers %}
  {{ l.name }}_seed:
    caches: [{{ l.name }}_cache]
    grids: {{ mp.grids | tojson_c }}
    coverages: [area]
    levels:
      from: {{ mp.seed.levels[0] }}
      to: {{ mp.seed.levels[1] }}
    refresh_before:
      time: 2000-01-01T00:00:00
{% endfor %}

coverages:
  area:
    bbox: {{ mp.seed.bbox | tojson_c }}
    srs: 'EPSG:4326'
{% else %}
# Seeding disabled in the installer. Example:
#
# seeds:
#   mylayer_seed:
#     caches: [mylayer_cache]
#     coverages: [area]
#     levels: {from: 0, to: 10}
# coverages:
#   area: {bbox: [39.9, 41.0, 46.8, 43.7], srs: 'EPSG:4326'}
seeds: {}
{% endif %}

# Generated by gisstack {{ version }} ({{ target }})
{% set ns = namespace(srs=[]) %}
{% for g in grids_all %}
{% if g.id in mp.grids %}
{% set s = 'EPSG:3857' if g.id == 'GLOBAL_WEBMERCATOR' else ('EPSG:4326' if g.id == 'GLOBAL_GEODETIC' else g.srs) %}
{% set ns.srs = ns.srs + [s] %}
{% endif %}
{% endfor %}
{% set transparent = mp.format != 'image/jpeg' %}
services:
{% if mp.demo %}
  demo:
{% endif %}
  tms:
    use_grid_names: true
    origin: nw
  wmts:
  wms:
    srs: {{ ns.srs | tojson_c }}
    image_formats: ['image/png', 'image/jpeg']
    md:
      title: {{ (wm.title_en ~ ' MapProxy') | yq }}
      abstract: Cached map services generated by gisstack

layers:
{% if mp.upstream_basemap == 'osm' %}
  - name: basemap
    title: OpenStreetMap (cached)
    sources: [basemap_cache]
{% endif %}
{% for l in mp.layers %}
  - name: {{ l.name }}
    title: {{ l.title | yq }}
    sources: [{{ l.name }}_cache]
{% endfor %}

caches:
{% if mp.upstream_basemap == 'osm' %}
  basemap_cache:
    grids: [GLOBAL_WEBMERCATOR]
    sources: [osm_tiles]
    format: image/png
    cache:
      type: file
{% endif %}
{% for l in mp.layers %}
{# a tile source is a fixed Web Mercator grid: MapProxy cannot reproject it (SRS mismatch -> HTTP 500 on every tile) #}
  {{ l.name }}_cache:
    grids: {{ ((['GLOBAL_WEBMERCATOR']) if l.source == 'tiles' else mp.grids) | tojson_c }}
    sources: [{{ l.name }}_src]
{% if mp.format == 'mixed' %}
    format: mixed
    request_format: image/png
{% else %}
    format: {{ mp.format }}
{% endif %}
    meta_size: {{ mp.meta_size | tojson_c }}
    meta_buffer: {{ mp.meta_buffer }}
    cache:
{% if mp.cache_type == 'file' %}
      type: file
      directory_layout: tms
{% elif mp.cache_type == 'sqlite' %}
      type: sqlite
{% else %}
      type: geopackage
      filename: {{ (up.mapproxy_cache ~ '/' ~ l.name ~ '.gpkg') | yq }}
      table_name: {{ l.name }}
{% endif %}
{% endfor %}

sources:
{% if mp.upstream_basemap == 'osm' %}
  # NOTE: OpenStreetMap's public tile servers are for light use only
  # (https://operations.osmfoundation.org/policies/tiles/). Do not seed them
  # at scale; use your own tile source for production.
  osm_tiles:
    type: tile
    grid: GLOBAL_WEBMERCATOR
    url: https://tile.openstreetmap.org/%(z)s/%(x)s/%(y)s.png
    http:
      headers:
        User-Agent: gisstack-mapproxy/{{ version }} ({{ cfg.email or 'admin@' ~ domain }})
{% endif %}
{% for l in mp.layers %}
  {{ l.name }}_src:
{% if l.source == 'geoserver' %}
    type: wms
    req:
      url: http://{{ up.geoserver }}/geoserver/wms
      layers: {{ l.wms_layers | yq }}
{% if transparent %}
      transparent: true
{% endif %}
{% elif l.source == 'qgis' %}
    type: wms
    req:
      url: http://{{ up.qgis }}/?MAP={{ up.qgis_projects }}/{{ l.qgis_map | default('project.qgs') }}
      layers: {{ l.wms_layers | yq }}
{% if transparent %}
      transparent: true
{% endif %}
{% elif l.source == 'tiles' %}
    type: tile
    grid: GLOBAL_WEBMERCATOR
    url: {{ l.url | replace('{z}', '%(z)s') | replace('{x}', '%(x)s') | replace('{y}', '%(y)s') | yq }}
{% else %}
    type: wms
    req:
      url: {{ l.url | yq }}
      layers: {{ l.wms_layers | yq }}
{% if transparent %}
      transparent: true
{% endif %}
{% endif %}
{% endfor %}

grids:
{% for g in grids_all %}
{% if g.id in mp.grids and g.srs is defined %}
  {{ g.id }}:
    srs: {{ g.srs | yq }}
    bbox: {{ g.bbox | tojson_c }}
    bbox_srs: {{ g.srs | yq }}
    origin: nw
{% endif %}
{% endfor %}

globals:
  cache:
    base_dir: {{ up.mapproxy_cache | yq }}
    lock_dir: {{ (up.mapproxy_cache ~ '/locks') | yq }}
    tile_lock_dir: {{ (up.mapproxy_cache ~ '/tile_locks') | yq }}
    concurrent_tile_creators: {{ mp.concurrent_tile_creators }}
  image:
    resampling_method: bicubic
  http:
    client_timeout: 60
